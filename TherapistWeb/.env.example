NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server-only Cloudflare TURN credentials. Never prefix these with NEXT_PUBLIC_.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_API_TOKEN=
PHYSIOAI_TURN_TTL_SECONDS=3600

# Server-only patient session video storage. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Optional: an existing private Drive folder owned by the OAuth account.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
