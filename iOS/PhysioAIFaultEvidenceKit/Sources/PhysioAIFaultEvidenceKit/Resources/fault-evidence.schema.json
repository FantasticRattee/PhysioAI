{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://physioai.local/schemas/native-fault-evidence-v1.json",
  "title": "PhysioAI Native Fault Evidence Record",
  "description": "Derived, process-local evidence. Raw video, pixel coordinates, raw landmark arrays and patient identifiers are excluded.",
  "type": "object",
  "required": ["schema", "moduleID", "moduleVersion", "exerciseID", "sourceGenerations", "coverage", "repetitionSummary", "faultObservations", "commentObservations"],
  "properties": {
    "schema": { "const": "physioai.native.fault_evidence.v1" },
    "moduleID": { "type": "string" },
    "moduleVersion": { "type": "string" },
    "exerciseID": { "type": "string" },
    "sourceGenerations": { "type": "array", "items": { "type": "integer" } },
    "coverage": {
      "type": "object",
      "required": ["observedFrames", "assessableFrames", "skippedFrames", "skippedReasonCounts"],
      "properties": {
        "observedFrames": { "type": "integer", "minimum": 0 },
        "assessableFrames": { "type": "integer", "minimum": 0 },
        "skippedFrames": { "type": "integer", "minimum": 0 },
        "skippedReasonCounts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
      },
      "additionalProperties": false
    },
    "repetitionSummary": {
      "type": "object",
      "required": ["totalReps", "commentFlaggedRepIndexes", "commentFlaggedRepCount", "correctRepCount", "incorrectRepCount", "correctnessStatus"],
      "properties": {
        "totalReps": { "type": "integer", "minimum": 0 },
        "commentFlaggedRepIndexes": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "commentFlaggedRepCount": { "type": "integer", "minimum": 0 },
        "correctRepCount": { "type": ["integer", "null"], "minimum": 0 },
        "incorrectRepCount": { "type": ["integer", "null"], "minimum": 0 },
        "correctnessStatus": { "type": "string" }
      },
      "additionalProperties": false
    },
    "faultObservations": { "type": "array", "items": { "$ref": "#/$defs/observation" } },
    "commentObservations": { "type": "array", "items": { "$ref": "#/$defs/observation" } }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "required": ["id", "kind", "semanticID", "bodyRegion", "landmarkRefs", "metric", "severity", "confidence", "sourceEngine", "sourceGeneration", "repIndex", "firstObservedAtMs", "lastObservedAtMs", "observationCount"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["fault_observation", "comment_observation"] },
        "semanticID": { "type": "string" },
        "bodyRegion": { "type": "string" },
        "landmarkRefs": { "type": "array", "items": { "type": "string" } },
        "metric": { "type": "object", "required": ["name", "value", "unit"] },
        "severity": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "sourceEngine": { "type": "string" },
        "sourceGeneration": { "type": "integer" },
        "repIndex": { "type": "integer", "minimum": 0 },
        "firstObservedAtMs": { "type": "integer" },
        "lastObservedAtMs": { "type": "integer" },
        "observationCount": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
